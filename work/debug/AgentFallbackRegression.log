tag=AgentFallbackRegression stage=sse.emit session_id=9aa74494-e248-44e7-96b0-2de29d6a82aa assistant_message_id=55cbdc30-6a8a-45ab-bd1e-207093890746 event=execution_trace_completed status=Completed citation_count=0
